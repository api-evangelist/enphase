                                {
                                  "name": "telemetry",
                                  "item": [
                                    {
                                      "name": "Retrieves telemetry for single ACB",
                                      "id": "fdf23754-404b-4dd3-a62b-bf32ee0df901",
                                      "protocolProfileBehavior": {
                                        "disableBodyPruning": true
                                      },
                                      "request": {
                                        "method": "GET",
                                        "header": [
                                          {
                                            "key": "Accept",
                                            "value": "application/json"
                                          }
                                        ],
                                        "url": {
                                          "raw": "{{baseUrl}}/api/v4/systems/:system_id/devices/acbs/:serial_no/telemetry?start_at=<integer>&granularity=day",
                                          "host": [
                                            "{{baseUrl}}"
                                          ],
                                          "path": [
                                            "api",
                                            "v4",
                                            "systems",
                                            ":system_id",
                                            "devices",
                                            "acbs",
                                            ":serial_no",
                                            "telemetry"
                                          ],
                                          "query": [
                                            {
                                              "description": "Start time for fetching the telemetry data in Epoch time format. Alternatively one can use start_date in place of start_at for passing the start date as String in YYYY-MM-DD format. By default start_at will appear in response. If start_date parameter is passed in the url, then start_date field will appear in response.",
                                              "key": "start_at",
                                              "value": "<integer>"
                                            },
                                            {
                                              "description": "The granularity of the telemetry data. Possible values are 'week', 'day', '15mins', '5mins'. Default is 'day'",
                                              "key": "granularity",
                                              "value": "day"
                                            }
                                          ],
                                          "variable": [
                                            {
                                              "id": "42b2dd56-4ef4-4e6c-91d4-7a15f7cbc51c",
                                              "key": "system_id",
                                              "value": "<integer>",
                                              "description": "(Required) System id"
                                            },
                                            {
                                              "id": "a29b9746-56dc-4a8d-b81f-40ca3dfada7d",
                                              "key": "serial_no",
                                              "value": "<string>",
                                              "description": "(Required) Serial Number of the acb"
                                            }
                                          ]
                                        },
                                        "description": "Retrieves telemetry for single ACB.\nIf no start_at is specified, defaults to midnight today, in the timezone of the system. If the start_at specified is earlier than the system\u2019s first reported date, then midnight of the system\u2019s first reported date is considered as start_at.\nThe end_at is calculated as the minimum of the time of the request and (start time + granularity).\nThe meaning of granularity is as follow:\n\nIf granularity is 15mins, maximum 1 interval will appear in response. If granularity is day, maximum 96 intervals, and if granularity is week, maximum 672 intervals, will appear in response where each interval is of 15 mins duration.\n\nThe requested start date must be within 2 years from current date.\nBy default start_at will appear in response. If start_date parameter is passed in the url, then start_date field will appear in response.\nBy default end_at will appear in response. If end_date parameter is passed in the url then end_date field will appear in response. Empty list will be returned if the last interval < requested start time < current time."
                                      },
                                      "response": [
                                        {
                                          "id": "450ed75a-346c-4e87-988b-99f53a98f066",
                                          "name": "Telemetry for the ACB",
                                          "originalRequest": {
                                            "method": "GET",
                                            "header": [
                                              {
                                                "key": "Accept",
                                                "value": "application/json"
                                              },
                                              {
                                                "description": "Added as a part of security scheme: bearer",
                                                "key": "Authorization",
                                                "value": "Bearer <token>"
                                              }
                                            ],
                                            "url": {
                                              "raw": "{{baseUrl}}/api/v4/systems/:system_id/devices/acbs/:serial_no/telemetry?start_at=<integer>&granularity=day",
                                              "host": [
                                                "{{baseUrl}}"
                                              ],
                                              "path": [
                                                "api",
                                                "v4",
                                                "systems",
                                                ":system_id",
                                                "devices",
                                                "acbs",
                                                ":serial_no",
                                                "telemetry"
                                              ],
                                              "query": [
                                                {
                                                  "description": "Start time for fetching the telemetry data in Epoch time format. Alternatively one can use start_date in place of start_at for passing the start date as String in YYYY-MM-DD format. By default start_at will appear in response. If start_date parameter is passed in the url, then start_date field will appear in response.",
                                                  "key": "start_at",
                                                  "value": "<integer>"
                                                },
                                                {
                                                  "description": "The granularity of the telemetry data. Possible values are 'week', 'day', '15mins', '5mins'. Default is 'day'",
                                                  "key": "granularity",
                                                  "value": "day"
                                                }
                                              ],
                                              "variable": [
                                                {
                                                  "key": "system_id"
                                                },
                                                {
                                                  "key": "serial_no"
                                                }
                                              ]
                                            }
                                          },
                                          "status": "OK",
                                          "code": 200,
                                          "_postman_previewlanguage": "json",
                                          "header": [
                                            {
                                              "key": "Content-Type",
                                              "value": "application/json"
                                            }
                                          ],
                                          "cookie": [],
                                          "responseTime": null,
                                          "body": "{\n  \"system_id\": \"<integer>\",\n  \"serial_number\": \"<string>\",\n  \"granularity\": \"15mins\",\n  \"total_devices\": \"<integer>\",\n  \"start_at\": \"<integer>\",\n  \"end_at\": \"<integer>\",\n  \"items\": \"<string>\",\n  \"intervals\": [\n    {\n      \"end_at\": \"<integer>\",\n      \"charge\": {\n        \"enwh\": \"<integer>\"\n      },\n      \"discharge\": {\n        \"enwh\": \"<integer>\"\n      },\n      \"soc\": {\n        \"percent\": \"<integer>\"\n      }\n    },\n    {\n      \"end_at\": \"<integer>\",\n      \"charge\": {\n        \"enwh\": \"<integer>\"\n      },\n      \"discharge\": {\n        \"enwh\": \"<integer>\"\n      },\n      \"soc\": {\n        \"percent\": \"<integer>\"\n      }\n    }\n  ],\n  \"last_reported_time\": \"<integer>\",\n  \"last_reported_soc\": \"<string>\"\n}",
                                          "createdAt": "2026-10-21T20:55:36.000Z",
